{
	email nat@natwelch.com
	# debug

	admin off

	order authenticate before respond
	order authorize before basicauth
	order rate_limit after authorize

	# https://zerossl.com/documentation/acme/
	acme_ca https://acme.zerossl.com/v2/DV90

	log default {
		output stdout
		format json
		exclude http.log.error.opencode
	}

	# Access-log filters don't cover proxy errors; those can contain the same URL.
	log opencode-errors {
		include http.log.error.opencode
		output stdout
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers delete
			}
		}
	}

	metrics /metrics

	security {
		oauth identity provider github {env.OAUTH_CLIENT_ID} {env.OAUTH_CLIENT_SECRET}

		authentication portal myportal {
			crypto default token lifetime 86400
			cookie lifetime 172800

			crypto key sign-verify {env.JWT_SHARED_KEY}
			cookie domain newyork.welch.io
			enable identity provider github

			transform user {
				exact match sub github.com/icco
				action add role authp/admin
				action add role admin
			}

			ui {
				# https://docs.authcrunch.com/docs/authenticate/ui-features
				theme basic
				custom css path /srv/themes/custom.css
				# static_asset "assets/images/favicon.png" "image/png" "/srv/assets/favicon.png"
				static_asset "assets/images/logo.svg" "image/svg+xml" /srv/themes/logo.svg

				# https://icons8.com/line-awesome
				links {
					"Archive Team Warrior" /archive/ icon "las la-dragon"
					"Files" /files/ icon "las la-sitemap"
					"FlightAware" /skyaware/ icon "las la-plane-departure"
					"Grafana" /grafana/ icon "las la-chart-line"
					"Kavita" /kavita/ icon "las la-book"
					"Lidarr" /lidarr/ icon "las la-headphones"
					"Loans" /acntng/ icon "las la-hand-holding-usd"
					"Prowlarr" /prowlarr/ icon "las la-paw"
					"Radarr" /radarr/ icon "las la-film"
					"Readarr" /readarr/ icon "las la-book"
					"Romm" /romm/ icon "las la-gamepad"
					"Sabnzbd" /sabnzbd/ icon "las la-download"
					"SlSkD" /slskd/ icon "las la-file-audio"
					"Sonarr" /sonarr/ icon "las la-tv"
				}
			}
		}

		authorization policy mypolicy {
			bypass uri prefix /metrics
			bypass uri prefix /grafana/metrics

			set auth url {$OAUTH_AUTH_URL}
			crypto key verify {env.JWT_SHARED_KEY}
			allow roles authp/admin authp/user
			validate bearer header
			inject headers with claims
			inject header "X-WEBAUTH-USER" from "sub"
			inject header "X-WEBAUTH-EMAIL" from "email"
		}
	}
}

# Imported by OpenCode's Docker label; authentication remains in OpenCode.
(opencode-web) {
	log opencode {
		format filter {
			wrap json
			fields {
				# Pairing codes live in paths; auth_token and PTY tickets in queries.
				# Keep host, method, client IP and status for Fail2Ban, not URLs.
				request>uri delete
				request>headers delete
				resp_headers delete
			}
		}
	}

	route {
		header {
			defer
			Strict-Transport-Security "max-age=31536000"
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
			X-Frame-Options DENY
			# Add a second policy, preserving OpenCode's script hashes/wasm policy.
			+Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		}

		@sensitive path /api /api/* /auth /auth/* /openapi.json
		header @sensitive {
			Cache-Control no-store
			defer
		}

		# CORS alone does not reject a credentialed request before execution.
		# This also protects WebSocket upgrades and requests from sibling sites.
		@foreign_origin {
			header Origin *
			not header Origin https://opencode.natwelch.com
		}
		respond @foreign_origin "Forbidden" 403

		reverse_proxy opencode:4096 {
			flush_interval -1
		}
	}
}

newyork.welch.io {
	log

	route /auth* {
		authenticate with myportal
	}

	route /healthz {
		respond "ok."
	}

	route /radarr/* {
		authorize with mypolicy
		reverse_proxy rope.local:7878
	}

	route /prowlarr/* {
		authorize with mypolicy
		reverse_proxy rope.local:9696
	}

	route /sonarr/* {
		authorize with mypolicy
		reverse_proxy rope.local:8989
	}

	route /lidarr/* {
		authorize with mypolicy
		reverse_proxy rope.local:8686
	}

	route /slskd/* {
		authorize with mypolicy
		reverse_proxy rope.local:5030
	}

	route /readarr/* {
		authorize with mypolicy
		reverse_proxy rope.local:8787
	}

	route /sabnzbd/* {
		authorize with mypolicy
		reverse_proxy rope.local:8080
	}

	route /kavita/* {
		reverse_proxy rope.local:5000
	}

	route /grafana/* {
		authorize with mypolicy
		reverse_proxy rope.local:3000
	}

	# On mist, so it resolves by container name. The redirect is needed because
	# strip_prefix on exactly /acntng would leave an empty path.
	redir /acntng /acntng/ 301

	route /acntng/* {
		authorize with mypolicy
		uri strip_prefix /acntng

		# acntng also checks this secret: siblings on this network can reach
		# acntng:8080 directly and skip the portal, and the portal's injected
		# headers are forgeable. The :default keeps an unset var from failing
		# the parse and taking every site down.
		reverse_proxy acntng:8080 {
			header_up X-Acntng-Key {$ACNTNG_SHARED_KEY:no-key-configured}
		}
	}

	# TODO: This is broken
	route /archive/* {
		authorize with mypolicy
		uri strip_prefix /archive
		reverse_proxy rope.local:8001
	}

	route /romm/* {
		encode zstd gzip

		header * {
			X-XSS-Protection "1; mode=block"
			X-Frame-Options "SAMEORIGIN"
			X-Robots-Tag "noindex, nofollow"
			-Server
			-X-Powered-By
		}

		uri strip_prefix /romm
		reverse_proxy rope.local:7676
	}

	route /skyaware/* {
		authorize with mypolicy
		reverse_proxy 192.168.1.51:80
	}

	route /files/* {
		authorize with mypolicy
		uri strip_prefix /files

		file_server {
			root /media/
			hide .* @*
			browse
		}
	}

	route / {
		redir https://{hostport}/auth 302
	}

	# Rate limit: 500 req/min per IP for all requests
	# 192.168.1.0/24 (LAN) and authenticated users are exempt
	@rate_limit_all {
		not remote_ip 192.168.1.0/24
		not header Authorization *
	}

	rate_limit @rate_limit_all {
		zone default_zone {
			match {
				method GET
			}

			key {remote_host}
			events 500
			window 1m
		}

		log_key
	}
}
